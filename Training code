last_path = str(SAVE_DIR/"last_model_fused.pth")

def mod_drop_schedule(ep):
    if ep <= 3:  return 0.05
    if ep <= 10: return 0.10
    return 0.15

def apply_modality_drop(fp, ir, p):
    B = fp.size(0)
    mfp = torch.ones(B,1, device=fp.device)
    mir = torch.ones(B,1, device=fp.device)
    if p <= 0:
        return fp, ir, mfp, mir
    r = torch.rand(B, device=fp.device)
    drop = (r < p)
    which = torch.rand(B, device=fp.device) < 0.5
    drop_fp = drop & which
    drop_ir = drop & (~which)
    if drop_fp.any():
        fp = fp.clone(); fp[drop_fp] = 0.0; mfp[drop_fp] = 0.0
    if drop_ir.any():
        ir = ir.clone(); ir[drop_ir] = 0.0; mir[drop_ir] = 0.0
    return fp, ir, mfp, mir

@torch.no_grad()
def evaluate_val_acc_fused():
    model.eval()
    correct, total = 0, 0
    for fp, ir, y in val_loader:
        fp, ir, y = fp.to(DEVICE), ir.to(DEVICE), y.to(DEVICE)
        logits, _, _, _, _ = model.forward_fused(fp, ir, y=None)
        pred = logits.argmax(1)
        correct += (pred == y).sum().item()
        total += y.numel()
    return correct / max(1, total)

history_fused = []
print("\n🔥 Stage-A: Train FUSED model (ResNet + Cross-Attention) from scratch...")
for ep in range(1, EPOCHS_FUSED+1):
    model.train()
    t0 = time.time()
    running = 0.0
    p_drop = mod_drop_schedule(ep)
    lam_w  = 0.05

    # ❌ تمت إزالة كود الـ freeze_bn الذي كان يسبب انهيار الـ NaNs هنا

    for step, (fp, ir, y) in enumerate(train_loader, 1):
        fp, ir, y = fp.to(DEVICE), ir.to(DEVICE), y.to(DEVICE)
        fp, ir, mfp, mir = apply_modality_drop(fp, ir, p_drop)

        opt.zero_grad(set_to_none=True)
        
        # ✅ تم التحديث لتجنب تحذير Deprecation
        with torch.amp.autocast('cuda', enabled=torch.cuda.is_available()):
            logits, z, g, q_fp, q_ir = model.forward_fused(fp, ir, y=y)
            loss_id = crit(logits, y)
            
            both = (mfp*mir).detach()
            wbal = (both * (q_fp - q_ir).abs()).mean() 
            loss = loss_id + lam_w * wbal

        scaler.scale(loss).backward()
        
        # ✅ تمت إضافة Gradient Clipping لحماية الأوزان من الانهيار (NaNs)
        scaler.unscale_(opt)
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
        
        scaler.step(opt)
        scaler.update()
        running += float(loss.item())

        if step % 50 == 0 or step == 1:
            print(f"Ep {ep:02d}/{EPOCHS_FUSED} | step {step:04d}/{len(train_loader)} | "
                  f"loss {loss.item():.4f} | "
                  f"mean(q_fp)={q_fp.mean().item():.3f} | mean(q_ir)={q_ir.mean().item():.3f}",
                  flush=True)

    sched.step()
    val_acc = evaluate_val_acc_fused()
    tr_loss = running / len(train_loader)
    dt = (time.time() - t0)/60.0
    print(f"✅ Epoch {ep:02d} DONE | TrainLoss={tr_loss:.4f} | ValAcc={val_acc*100:.2f}% | time={dt:.2f} min", flush=True)

    torch.save(model.state_dict(), last_path)
    if val_acc > best_acc:
        best_acc = val_acc
        torch.save(model.state_dict(), best_path)
        print(f"🏆 Saved BEST -> {best_path} (ValAcc={best_acc*100:.2f}%)", flush=True)

    history_fused.append({"epoch":ep, "train_loss":float(tr_loss), "val_acc":float(val_acc)})

print("\n✅ Stage-A finished.")
