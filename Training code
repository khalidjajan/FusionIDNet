# 5) Model Architecture (Q1 Level: ResNet + Cross-Attention)
# ==========================================================
class QualityGate(nn.Module):
    def __init__(self, emb_dim):
        super().__init__()
        self.fc = nn.Sequential(
            nn.Linear(emb_dim, 64),
            nn.ReLU(inplace=True),
            nn.Linear(64, 1),
            nn.Sigmoid()
        )
    def forward(self, emb):
        q = self.fc(emb)
        emb = emb * (0.5 + q)
        return emb, q

class ResNetBackbone(nn.Module):
    def __init__(self, out_dim=256):
        super().__init__()
        weights = models.ResNet18_Weights.IMAGENET1K_V1
        resnet = models.resnet18(weights=weights)
        self.features = nn.Sequential(*list(resnet.children())[:-1])
        self.proj = nn.Linear(512, out_dim)
        self.bn = nn.BatchNorm1d(out_dim)
        self.qgate = QualityGate(out_dim)

    def forward(self, x):
        x = self.features(x)
        x = x.view(x.size(0), -1)
        x = self.bn(self.proj(x))
        x, q = self.qgate(x)
        return x, q

class CrossAttentionFusion(nn.Module):
    def __init__(self, emb_dim):
        super().__init__()
        self.query_fp = nn.Linear(emb_dim, emb_dim)
        self.key_ir   = nn.Linear(emb_dim, emb_dim)
        self.value_ir = nn.Linear(emb_dim, emb_dim)
        
        self.query_ir = nn.Linear(emb_dim, emb_dim)
        self.key_fp   = nn.Linear(emb_dim, emb_dim)
        self.value_fp = nn.Linear(emb_dim, emb_dim)
        
        self.scale = emb_dim ** -0.5
        
        self.fc_fuse = nn.Sequential(
            nn.Linear(emb_dim * 2, emb_dim),
            nn.BatchNorm1d(emb_dim),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3)
        )

    def forward(self, fp, ir):
        q_fp = self.query_fp(fp).unsqueeze(1)
        k_ir = self.key_ir(ir).unsqueeze(1)
        v_ir = self.value_ir(ir).unsqueeze(1)
        attn_fp = F.softmax(torch.bmm(q_fp, k_ir.transpose(1, 2)) * self.scale, dim=-1)
        out_fp = torch.bmm(attn_fp, v_ir).squeeze(1) + fp

        q_ir = self.query_ir(ir).unsqueeze(1)
        k_fp = self.key_fp(fp).unsqueeze(1)
        v_fp = self.value_fp(fp).unsqueeze(1)
        attn_ir = F.softmax(torch.bmm(q_ir, k_fp.transpose(1, 2)) * self.scale, dim=-1)
        out_ir = torch.bmm(attn_ir, v_fp).squeeze(1) + ir
        
        fused = torch.cat([out_fp, out_ir], dim=1)
        return self.fc_fuse(fused), attn_fp.squeeze(1), attn_ir.squeeze(1)

class ArcFace(nn.Module):
    def __init__(self, in_features, out_features, s=30.0, m=0.35):
        super().__init__()
        self.s = s; self.m = m
        self.W = nn.Parameter(torch.randn(out_features, in_features))
        nn.init.xavier_uniform_(self.W)

    def forward(self, x, y=None):
        x = l2n(x, dim=1)
        W = l2n(self.W, dim=1)
        cos = F.linear(x, W)
        if y is None:
            return cos * self.s
        sin = torch.sqrt(torch.clamp(1.0 - cos**2, min=1e-7))
        phi = cos*math.cos(self.m) - sin*math.sin(self.m)
        onehot = torch.zeros_like(cos)
        onehot.scatter_(1, y.view(-1,1), 1.0)
        out = onehot*phi + (1.0-onehot)*cos
        return out * self.s

class FusionIDNet(nn.Module):
    def __init__(self, num_classes, emb_dim=256):
        super().__init__()
        self.emb_dim = emb_dim
        self.fp_net = ResNetBackbone(out_dim=emb_dim)
        self.ir_net = ResNetBackbone(out_dim=emb_dim)

        self.fusion = CrossAttentionFusion(emb_dim)
        self.arc = ArcFace(emb_dim, num_classes, s=30.0, m=0.35)

        # Unimodal Adapters (Stage B)
        self.fp_adapter = nn.Sequential(
            nn.Linear(emb_dim, emb_dim),
            nn.ReLU(inplace=True),
            nn.Linear(emb_dim, emb_dim),
        )
        self.fp_alpha = nn.Parameter(torch.tensor(0.1)) # Learnable Adapter Weight

        self.ir_adapter = nn.Sequential(
            nn.Linear(emb_dim, emb_dim),
            nn.ReLU(inplace=True),
            nn.Linear(emb_dim, emb_dim),
        )
        self.ir_alpha = nn.Parameter(torch.tensor(0.1))

        self.fp_uhead = nn.Sequential(
            nn.Linear(emb_dim, emb_dim),
            nn.BatchNorm1d(emb_dim),
            nn.ReLU(inplace=True),
        )
        self.ir_uhead = nn.Sequential(
            nn.Linear(emb_dim, emb_dim),
            nn.BatchNorm1d(emb_dim),
            nn.ReLU(inplace=True),
        )

    def forward_fused(self, fp, ir, y=None):
        fp_e, q_fp = self.fp_net(fp)
        ir_e, q_ir = self.ir_net(ir)
        
        z, attn_fp, attn_ir = self.fusion(fp_e, ir_e)
        logits = self.arc(z, y)
        
        g = torch.cat([attn_fp, attn_ir], dim=1) # Pseudo-gate for tracking
        return logits, z, g, q_fp, q_ir

    def forward_fp_only(self, fp, y=None):
        fp_e, q_fp = self.fp_net(fp)
        fp_e = fp_e + self.fp_alpha * self.fp_adapter(fp_e)
        z = self.fp_uhead(fp_e)
        logits = self.arc(z, y)
        return logits, z, q_fp

    def forward_ir_only(self, ir, y=None):
        ir_e, q_ir = self.ir_net(ir)
        ir_e = ir_e + self.ir_alpha * self.ir_adapter(ir_e)
        z = self.ir_uhead(ir_e)
        logits = self.arc(z, y)
        return logits, z, q_ir

