def print_dataset_structure(root_dir, max_depth=5, max_items=3):
    root_path = Path("/kaggle/input/datasets/khalidjajan/dataset-last3/dataset-last3")
    if not root_path.exists():
        print(f"❌ المسار غير موجود: {root_dir}")
        return

    print(f"📂 {root_path.name}/")

    def walk_dir(current_path, current_depth, prefix):
        if current_depth > max_depth:
            return

        try:
            items = sorted(list(current_path.iterdir()))
        except PermissionError:
            return

        # فصل المجلدات عن الملفات لترتيب العرض
        dirs = [x for x in items if x.is_dir()]
        files = [x for x in items if x.is_file()]
        display_items = dirs + files
        total_items = len(display_items)

        for i, item in enumerate(display_items):
            if i >= max_items:
                print(prefix + "└── ... (والمزيد)")
                break

            is_last = (i == total_items - 1) or (i == max_items - 1)
            connector = "└── " if is_last else "├── "

            if item.is_dir():
                print(prefix + connector + "📁 " + item.name)
                extension = "    " if is_last else "│   "
                walk_dir(item, current_depth + 1, prefix + extension)
            else:
                print(prefix + connector + "📄 " + item.name)

    walk_dir(root_path, 1, "")

