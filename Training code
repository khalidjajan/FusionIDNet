        if mode == "fused":
            fp_imgs = sample_templates("fingerprint", split, emb_level, sid, k=templates)
            ir_imgs = sample_templates("iris",        split, emb_level, sid, k=templates)
            if len(fp_imgs)==0 or len(ir_imgs)==0:
                continue
            cand = [(fp,ir) for fp in fp_imgs for ir in ir_imgs]

            if method == "single":
                cand = [(fp_imgs[0], ir_imgs[0])]
            elif method == "random5":
                rng.shuffle(cand)
                cand = cand[:min(templates, len(cand))]
            elif method == "qf5":
                scored=[]
                for fp_p, ir_p in cand:
                    fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                    ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                    z, _, qfp, qir = embed_fused(fp, ir)
                    score = float((qfp*qir).item())
                    scored.append((score, z.squeeze(0).cpu()))
                scored.sort(key=lambda x: x[0], reverse=True)
                top = scored[:min(templates, len(scored))]
                z_mean = torch.stack([t[1] for t in top], 0).mean(0)
                gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))
                continue
            
            zs=[]
            for fp_p, ir_p in cand:
                fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                z, _, _, _ = embed_fused(fp, ir)
                zs.append(z.squeeze(0).cpu())
            z_mean = torch.stack(zs, 0).mean(0)
            gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))

        elif mode == "fp":
            fp_imgs = sample_templates("fingerprint", split, emb_level, sid, k=templates)
            if len(fp_imgs)==0: continue
            if method == "single":
                picks = [fp_imgs[0]]
            elif method == "random5":
                picks = fp_imgs[:min(templates, len(fp_imgs))]
            elif method == "qf5":
                scored=[]
                for fp_p in fp_imgs:
                    fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                    z, q = embed_fp_only(fp)
                    scored.append((float(q.item()), z.squeeze(0).cpu()))
                scored.sort(key=lambda x: x[0], reverse=True)
                top = scored[:min(templates, len(scored))]
                z_mean = torch.stack([t[1] for t in top], 0).mean(0)
                gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))
                continue

            zs=[]
            for fp_p in picks:
                fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                z, q = embed_fp_only(fp)
                zs.append(z.squeeze(0).cpu())
            z_mean = torch.stack(zs, 0).mean(0)
            gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))

        elif mode == "ir":
            ir_imgs = sample_templates("iris", split, emb_level, sid, k=templates)
            if len(ir_imgs)==0: continue
            if method == "single":
                picks = [ir_imgs[0]]
            elif method == "random5":
                picks = ir_imgs[:min(templates, len(ir_imgs))]
            elif method == "qf5":
                scored=[]
                for ir_p in ir_imgs:
                    ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                    z, q = embed_ir_only(ir)
                    scored.append((float(q.item()), z.squeeze(0).cpu()))
                scored.sort(key=lambda x: x[0], reverse=True)
                top = scored[:min(templates, len(scored))]
                z_mean = torch.stack([t[1] for t in top], 0).mean(0)
                gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))
                continue

            zs=[]
            for ir_p in picks:
                ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                z, q = embed_ir_only(ir)
                zs.append(z.squeeze(0).cpu())
            z_mean = torch.stack(zs, 0).mean(0)
            gal_names.append(sid); gal_vecs.append(F.normalize(z_mean, dim=0))

    gal_mat = torch.stack(gal_vecs, 0).to(DEVICE)
    return gal_names, gal_mat

@torch.no_grad()
def eval_rankK(level, gal_names, gal_mat, mode="fused", max_fp=6, max_ir=6):
    model.eval()
    split="test"
    correct1=0; correct5=0; total=0
    name_to_idx = {n:i for i,n in enumerate(gal_names)}

    for sid in SUBJECTS:
        if sid not in name_to_idx:
            continue
        if mode == "fused":
            fp_imgs = list_imgs(OUT_ROOT/"fingerprint"/split/level/sid)[:max_fp]
            ir_imgs = list_imgs(OUT_ROOT/"iris"/split/level/sid)[:max_ir]
            if len(fp_imgs)==0 or len(ir_imgs)==0: continue
            for fp_p in fp_imgs:
                for ir_p in ir_imgs:
                    fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                    ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                    z, _, _, _ = embed_fused(fp, ir)
                    sims = torch.matmul(z, gal_mat.T).squeeze(0)
                    k = min(5, sims.numel())
                    topk = torch.topk(sims, k=k).indices.tolist()
                    pred1 = gal_names[topk[0]]
                    predk = [gal_names[i] for i in topk]
                    total += 1
                    correct1 += int(pred1==sid)
                    correct5 += int(sid in predk)

        elif mode == "fp":
            fp_imgs = list_imgs(OUT_ROOT/"fingerprint"/split/level/sid)[:max_fp]
            if len(fp_imgs)==0: continue
            for fp_p in fp_imgs:
                fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                z, _ = embed_fp_only(fp)
                sims = torch.matmul(z, gal_mat.T).squeeze(0)
                k = min(5, sims.numel())
                topk = torch.topk(sims, k=k).indices.tolist()
                pred1 = gal_names[topk[0]]
                predk = [gal_names[i] for i in topk]
                total += 1
                correct1 += int(pred1==sid)
                correct5 += int(sid in predk)

        elif mode == "ir":
            ir_imgs = list_imgs(OUT_ROOT/"iris"/split/level/sid)[:max_ir]
            if len(ir_imgs)==0: continue
            for ir_p in ir_imgs:
                ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                z, _ = embed_ir_only(ir)
                sims = torch.matmul(z, gal_mat.T).squeeze(0)
                k = min(5, sims.numel())
                topk = torch.topk(sims, k=k).indices.tolist()
                pred1 = gal_names[topk[0]]
                predk = [gal_names[i] for i in topk]
                total += 1
                correct1 += int(pred1==sid)
                correct5 += int(sid in predk)

    return correct1/max(1,total), correct5/max(1,total), total

@torch.no_grad()
def verification_metrics(level, gal_names, gal_mat, mode="fused", max_fp=6, max_ir=6):
    model.eval()
    split="test"
    name_to_idx = {n:i for i,n in enumerate(gal_names)}
    genuine=[]; impostor=[]

    for sid in SUBJECTS:
        if sid not in name_to_idx: continue
        true_idx = name_to_idx[sid]

        if mode=="fused":
            fp_imgs = list_imgs(OUT_ROOT/"fingerprint"/split/level/sid)[:max_fp]
            ir_imgs = list_imgs(OUT_ROOT/"iris"/split/level/sid)[:max_ir]
            if len(fp_imgs)==0 or len(ir_imgs)==0: continue
            for fp_p in fp_imgs:
                for ir_p in ir_imgs:
                    fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                    ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                    z, _, _, _ = embed_fused(fp, ir)
                    sims = torch.matmul(z, gal_mat.T).squeeze(0).cpu().numpy()
                    genuine.append(sims[true_idx])
                    impostor.extend(np.delete(sims, true_idx))

        elif mode=="fp":
            fp_imgs = list_imgs(OUT_ROOT/"fingerprint"/split/level/sid)[:max_fp]
            if len(fp_imgs)==0: continue
            for fp_p in fp_imgs:
                fp = eval_tf(load_pil(fp_p)).unsqueeze(0).to(DEVICE)
                z, _ = embed_fp_only(fp)
                sims = torch.matmul(z, gal_mat.T).squeeze(0).cpu().numpy()
                genuine.append(sims[true_idx])
                impostor.extend(np.delete(sims, true_idx))

        elif mode=="ir":
            ir_imgs = list_imgs(OUT_ROOT/"iris"/split/level/sid)[:max_ir]
            if len(ir_imgs)==0: continue
            for ir_p in ir_imgs:
                ir = eval_tf(load_pil(ir_p)).unsqueeze(0).to(DEVICE)
                z, _ = embed_ir_only(ir)
                sims = torch.matmul(z, gal_mat.T).squeeze(0).cpu().numpy()
                genuine.append(sims[true_idx])
                impostor.extend(np.delete(sims, true_idx))

    genuine=np.array(genuine, dtype=np.float32)
    impostor=np.array(impostor, dtype=np.float32)
    y_true = np.concatenate([np.ones_like(genuine), np.zeros_like(impostor)])
    y_score= np.concatenate([genuine, impostor])

    auc = roc_auc_score(y_true, y_score)
    fpr, tpr, thr = roc_curve(y_true, y_score)
    fnr = 1 - tpr
    idx = np.argmin(np.abs(fpr - fnr))
    eer = float((fpr[idx] + fnr[idx]) / 2)
    eer_thr = float(thr[idx])

    def tar_at_far(target_far):
        ok = np.where(fpr <= target_far)[0]
        if len(ok)==0: return float(tpr[0])
        return float(np.max(tpr[ok]))

    return {
        "genuine": int(len(genuine)),
        "impostor": int(len(impostor)),
        "EER": eer,
        "EER_thr": eer_thr,
        "AUC": float(auc),
        "TAR@1e-3": tar_at_far(1e-3),
        "TAR@1e-4": tar_at_far(1e-4),
        "fpr": fpr, "tpr": tpr
    }

