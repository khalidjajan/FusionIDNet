class UniTrainDataset(Dataset):
    def __init__(self, root, mode="fp", split="train", use_levels=None, transform=None, per_subject=25):
        self.root = Path(root)
        self.mode = mode
        self.split = split
        self.use_levels = list(use_levels or TRAIN_LEVELS)
        self.transform = transform
        self.subjects = SUBJECTS

        self.items = []
        modality = "fingerprint" if mode=="fp" else "iris"
        for s in self.subjects:
            for _ in range(per_subject):
                lvl = random.choice(self.use_levels)
                imgs = list_imgs(self.root/modality/split/lvl/s)
                if len(imgs)==0:
                    imgs = list_imgs(self.root/modality/split/self.use_levels[0]/s)
                if len(imgs)==0:
                    continue
                self.items.append((random.choice(imgs), class_to_idx[s]))
        print(f"✅ UniTrainDataset({mode}) | items={len(self.items)} | levels={self.use_levels}")

    def __len__(self): return len(self.items)

    def __getitem__(self, idx):
        p, y = self.items[idx]
        x = self.transform(load_pil(p))
        return x, y

def set_requires_grad(m: nn.Module, flag: bool):
    for p in m.parameters():
        p.requires_grad = flag

set_requires_grad(model, False)
set_requires_grad(model.fp_adapter, True)
set_requires_grad(model.fp_uhead, True)
model.fp_alpha.requires_grad = True
set_requires_grad(model.ir_adapter, True)
set_requires_grad(model.ir_uhead, True)
model.ir_alpha.requires_grad = True

fp_uni_ds = UniTrainDataset(OUT_ROOT, mode="fp", split="train", use_levels=TRAIN_LEVELS, transform=train_tf, per_subject=25)
ir_uni_ds = UniTrainDataset(OUT_ROOT, mode="ir", split="train", use_levels=TRAIN_LEVELS, transform=train_tf, per_subject=25)

fp_uni_loader = DataLoader(fp_uni_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=True, drop_last=True)
ir_uni_loader = DataLoader(ir_uni_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=True, drop_last=True)

opt_u = torch.optim.AdamW(
    list(model.fp_adapter.parameters()) + list(model.fp_uhead.parameters()) + [model.fp_alpha] +
    list(model.ir_adapter.parameters()) + list(model.ir_uhead.parameters()) + [model.ir_alpha],
    lr=5e-4, weight_decay=WD
)
sched_u = torch.optim.lr_scheduler.CosineAnnealingLR(opt_u, T_max=EPOCHS_UNI)

# ✅ تم التحديث لتجنب تحذير Deprecation
scaler_u = torch.amp.GradScaler('cuda', enabled=torch.cuda.is_available())

def cycle(dl):
    while True:
        for b in dl:
            yield b

fp_iter = cycle(fp_uni_loader)
ir_iter = cycle(ir_uni_loader)

history_uni = []
print("\n🔥 Stage-B: Train unimodal adapters (fix FP-only/IR-only) with Learnable Alphas...")
for ep in range(1, EPOCHS_UNI+1):
    model.train()
    t0 = time.time()
    running = 0.0
    steps = min(len(fp_uni_loader), len(ir_uni_loader))

    for step in range(1, steps+1):
        opt_u.zero_grad(set_to_none=True)
        if step % 2 == 1:
            x, y = next(fp_iter)
            x, y = x.to(DEVICE), y.to(DEVICE)
            
            # ✅ تم التحديث لتجنب تحذير Deprecation
            with torch.amp.autocast('cuda', enabled=torch.cuda.is_available()):
                logits, z, q = model.forward_fp_only(x, y=y)
                loss = crit(logits, y)
        else:
            x, y = next(ir_iter)
            x, y = x.to(DEVICE), y.to(DEVICE)
            
            # ✅ تم التحديث لتجنب تحذير Deprecation
            with torch.amp.autocast('cuda', enabled=torch.cuda.is_available()):
                logits, z, q = model.forward_ir_only(x, y=y)
                loss = crit(logits, y)

        scaler_u.scale(loss).backward()
        
        # ✅ تمت إضافة Gradient Clipping لحماية الأوزان في Stage B أيضاً
        scaler_u.unscale_(opt_u)
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
        
        scaler_u.step(opt_u)
        scaler_u.update()
        running += float(loss.item())

        if step % 50 == 0 or step == 1:
            print(f"Uni Ep {ep:02d}/{EPOCHS_UNI} | step {step:04d}/{steps} | loss {loss.item():.4f}", flush=True)

    sched_u.step()
    tr_loss = running / max(1, steps)
    dt = (time.time() - t0)/60.0
    print(f"✅ Uni Epoch {ep:02d} DONE | TrainLoss={tr_loss:.4f} | fp_alpha={model.fp_alpha.item():.3f} | ir_alpha={model.ir_alpha.item():.3f} | time={dt:.2f} min", flush=True)
    history_uni.append({"epoch":ep, "train_loss":float(tr_loss)})

print("✅ Stage-B finished.")
with open(SAVE_DIR/"train_history_unimodal.json","w") as f:
    json.dump(history_uni, f, indent=2)

