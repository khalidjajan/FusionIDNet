def is_prepared_root(p: Path):
    return (p/"fingerprint"/"train"/"clean").exists() and (p/"iris"/"train"/"clean").exists()

def is_raw_root(p: Path):
    return (p/"fingerprint"/"clean").exists() and (p/"iris"/"clean").exists()

def find_raw_root():
    base = Path("/kaggle/input")
    if not base.exists():
        raise FileNotFoundError("❌ /kaggle/input not found (are you running on Kaggle?).")

    candidates = []
    for d in base.rglob("*"):
        if d.is_dir() and is_raw_root(d):
            candidates.append(d)

    candidates = sorted(candidates, key=lambda x: len(str(x)))
    if len(candidates) == 0:
        raise FileNotFoundError(
            "❌ Could not auto-detect RAW dataset root under /kaggle/input.\n"
            "It must contain:\n"
            "  fingerprint/clean/<subject>/...\n"
            "  iris/clean/<subject>/...\n"
        )
    return candidates[0]

def split_list(items, r_train=0.70, r_val=0.15, r_test=0.15):
    items = items[:]
    random.shuffle(items)
    n = len(items)
    n_tr = int(r_train*n)
    n_va = int(r_val*n)
    tr = items[:n_tr]
    va = items[n_tr:n_tr+n_va]
    te = items[n_tr+n_va:]
    if len(te) == 0 and len(items) > 0:
        te = items[-1:]
    return tr, va, te

def rebuild_prepared_dataset(src_root: Path, out_root: Path, overwrite=True):
    if overwrite and out_root.exists():
        shutil.rmtree(out_root)
    out_root.mkdir(parents=True, exist_ok=True)

    for modality in ["fingerprint", "iris"]:
        base = src_root/modality
        assert base.exists(), f"❌ Missing modality folder: {base}"

        clean_dir = base/"clean"
        subjects = sorted([d.name for d in clean_dir.iterdir() if d.is_dir()])
        assert len(subjects) > 0, f"❌ No subjects found in {clean_dir}"

        for subj in subjects:
            for lvl in LEVELS_ALL:
                sdir = base/lvl/subj
                imgs = list_imgs(sdir)
                if len(imgs) == 0:
                    continue

                tr, va, te = split_list(imgs, 0.70, 0.15, 0.15)
                for split_name, lst in [("train", tr), ("val", va), ("test", te)]:
                    for img in lst:
                        dst = out_root/modality/split_name/lvl/subj/img.name
                        ensure_dir(dst.parent)
                        shutil.copy2(img, dst)

    print("✅ Prepared dataset created at:", out_root)

def make_zip(zip_path: Path, folder: Path):
    if zip_path.exists():
        zip_path.unlink()
    with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
        for f in folder.rglob("*"):
            if f.is_file():
                zf.write(f, f.relative_to(folder))
    print("✅ ZIP saved:", zip_path)

