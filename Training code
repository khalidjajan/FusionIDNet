class PairedTrainDataset(Dataset):
    def __init__(self, root, split, use_levels, transform, pairs_per_subject=30):
        self.root = Path(root); self.split = split
        self.use_levels = list(use_levels)
        self.transform = transform
        self.subjects = SUBJECTS
        self.pairs_per_subject = pairs_per_subject

        self.fp = {lvl:{} for lvl in self.use_levels}
        self.ir = {lvl:{} for lvl in self.use_levels}
        for lvl in self.use_levels:
            for s in self.subjects:
                self.fp[lvl][s] = list_imgs(self.root/"fingerprint"/split/lvl/s)
                self.ir[lvl][s] = list_imgs(self.root/"iris"/split/lvl/s)

        self.index = []
        for s in self.subjects:
            self.index += [s]*pairs_per_subject

        print(f"✅ TRAIN | subjects={len(self.subjects)} | items={len(self.index)} | levels={self.use_levels}")

    def __len__(self): return len(self.index)

    def _pick(self, table, lvl, s):
        lst = table[lvl][s]
        if len(lst)==0:
            lst = table[self.use_levels[0]][s]
        return random.choice(lst)

    def __getitem__(self, i):
        s = self.index[i]
        y = class_to_idx[s]
        lvl = random.choice(self.use_levels)
        fp_p = self._pick(self.fp, lvl, s)
        ir_p = self._pick(self.ir, lvl, s)
        fp = self.transform(load_pil(fp_p))
        ir = self.transform(load_pil(ir_p))
        return fp, ir, y

class PairedDeterministicDataset(Dataset):
    def __init__(self, root, split, use_levels, transform, max_fp=6, max_ir=6, seed=2026):
        self.root = Path(root); self.split = split
        self.use_levels = list(use_levels)
        self.transform = transform
        self.subjects = SUBJECTS

        rng = random.Random(seed + (0 if split=="val" else 999))
        pairs = []
        for lvl in self.use_levels:
            for s in self.subjects:
                fp_imgs = list_imgs(self.root/"fingerprint"/split/lvl/s)[:max_fp]
                ir_imgs = list_imgs(self.root/"iris"/split/lvl/s)[:max_ir]
                if len(fp_imgs)==0 or len(ir_imgs)==0:
                    continue
                comb = [(i,j) for i in range(len(fp_imgs)) for j in range(len(ir_imgs))]
                rng.shuffle(comb)
                take = min(len(comb), max(12, len(fp_imgs)+len(ir_imgs)))
                for (i,j) in comb[:take]:
                    pairs.append((fp_imgs[i], ir_imgs[j], class_to_idx[s]))
        self.pairs = pairs
        print(f"✅ {split.upper()} | pairs={len(self.pairs)} | levels={self.use_levels} (DETERMINISTIC)")

    def __len__(self): return len(self.pairs)

    def __getitem__(self, idx):
        fp_p, ir_p, y = self.pairs[idx]
        fp = self.transform(load_pil(fp_p))
        ir = self.transform(load_pil(ir_p))
        return fp, ir, y

